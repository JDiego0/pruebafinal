    rw_channels             ||--o{ rw_messages             : contains
    rw_users                ||--o{ rw_messages             : sends
    rw_messages             ||--o{ rw_messages             : "replies to"
    rw_messages             ||--o{ rw_message_edits        : "revised in"
    rw_messages             ||--o| rw_message_embeddings   : "vectorized as"
    rw_messages             ||--o{ rw_embedding_jobs       : "queued in"
    rw_ai_providers         ||--o{ rw_embedding_models     : offers
    rw_embedding_models     ||--o{ rw_message_embeddings   : "produced by"
    rw_users                ||--o{ rw_copilot_threads      : owns
