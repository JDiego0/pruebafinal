# =============================================================================
# Riwi Messaging Platform — environment template
# Copy to .env and fill in.  .env is git-ignored and MUST NEVER be committed.
#   cp .env.example .env
# =============================================================================

# ----- Database ---------------------------------------------------------------
POSTGRES_DB=bd_juandiego_garcia_nakamoto
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Bootstrap superuser — used only by the postgres container to create the roles below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

# Migration role: owns the schema, holds BYPASSRLS.
# Used ONLY by the `migrate` service and the seed loader. Never given to the backend.
RW_MIGRATOR_USER=rw_migrator
RW_MIGRATOR_PASSWORD=change-me-locally

# Application role: NOSUPERUSER, NOBYPASSRLS, DML only, no DELETE anywhere.
# This is the ONLY database identity the running backend uses.
RW_APP_USER=rw_app
RW_APP_PASSWORD=change-me-locally

# ----- Backend ----------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# 256-bit secret for HS256 access tokens.  Generate a fresh one per environment:
#   openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=riwi-messaging
JWT_AUDIENCE=riwi-messaging-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Set to true only when serving over HTTPS (adds Secure to the refresh cookie).
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ----- AI: chat provider (optional) -------------------------------------------
# MVP provider: GROQ. Groq exposes an OpenAI-compatible API, so the generic
# adapter reaches it with no code change — only these three values differ.
#
# The stack runs without a key: chat returns PROVIDER_UNAVAILABLE and every
# security property still holds and is still proven by the test suite.
# See DECISIONS.md D-06 and D-21.
#
# Other OpenAI-compatible endpoints work identically:
#   Groq    AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenAI  AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   Ollama  AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1
AI_ENABLED=false
AI_PROVIDER_CODE=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# ----- AI: embedding provider (optional, SEPARATE from chat) ------------------
# Groq publishes no embedding models and no /embeddings endpoint, so embeddings
# are configured independently of chat (DECISIONS.md D-21).
#
# Leave EMBEDDING_BASE_URL empty to use the built-in deterministic local
# provider — offline, no credentials, stable vectors. That is the default and
# it is what the security test suite runs against.
#
# Any configured model MUST emit 1536 dimensions: that is the width of the
# pgvector column, validated at startup. Changing it is a migration, not a setting.
#   OpenAI  EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small
#   Ollama  EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER_CODE=local
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# ----- RAG tuning -------------------------------------------------------------
RAG_CANDIDATE_LIMIT=12
RAG_SIMILARITY_FLOOR=0.25
RAG_MAX_CONTEXT_CHARS=6000

# ----- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DEFAULT_LOCALE=es

# ----- Supabase (optional deployment target — see docs/DEPLOYMENT.md) ---------
# Only needed to deploy the schema to a hosted Supabase project.
# Local Docker Compose does not use any of these.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
