# =============================================================================
# Riwi Messaging Platform — environment template
#
#   cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed. Every value below has a
# working default in docker-compose.yml, so `docker compose up --build` runs
# without a .env at all — but a real deployment must set its own secrets.
# =============================================================================

# ----- Database ---------------------------------------------------------------
POSTGRES_DB=bd_juandiego_garcia_nakamoto

# Bootstrap superuser. Used by the postgres container and by the `migrate`
# service, which is the only thing permitted to CREATE ROLE.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

# Migration role: owns the schema, holds BYPASSRLS.
# Used ONLY by the `migrate` and `seed` services. Never given to the backend.
RW_MIGRATOR_USER=rw_migrator
RW_MIGRATOR_PASSWORD=change-me-locally

# Application role: NOSUPERUSER, NOBYPASSRLS, no DELETE anywhere.
# This is the ONLY database identity the running backend uses.
RW_APP_USER=rw_app
RW_APP_PASSWORD=change-me-locally

# Host ports. Change these if something already listens on them.
POSTGRES_PORT_HOST=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Only needed when running the backend outside Docker (./mvnw spring-boot:run):
# inside compose these are set to the service name automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----- Backend ----------------------------------------------------------------
SERVER_PORT=8080

# HMAC secret for access tokens; its length picks HS256/HS384/HS512, and a
# secret too short for any of them is rejected at startup. Generate per environment:
#   openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=riwi-messaging
JWT_AUDIENCE=riwi-messaging-web
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Set to true only when serving over HTTPS (adds Secure to the refresh cookie).
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ----- AI: chat provider ------------------------------------------------------
# MVP provider: GROQ. Groq exposes an OpenAI-compatible API, so the generic
# adapter reaches it with no code change — only these values differ.
#
# Without a key the copilot answers PROVIDER_ERROR and everything else,
# including every security property and the whole test suite, still holds.
#
# Other OpenAI-compatible endpoints work identically:
#   Groq    AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
#   OpenAI  AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   Ollama  AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1
AI_ENABLED=false
AI_PROVIDER_CODE=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_SECONDS=30

# ----- AI: embedding provider (SEPARATE from chat) ----------------------------
# Groq publishes no embedding models and no /embeddings endpoint, so embeddings
# are configured independently of chat (DECISIONS.md D-21).
#
# Leave EMBEDDING_BASE_URL empty to use the built-in deterministic local
# provider — offline, no credentials, stable vectors. That is the default and
# it is what the security suite runs against.
#
# Any configured model MUST emit 1536 dimensions: that is the width of the
# pgvector column. Changing it is a migration, not a setting.
#   OpenAI  EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small
#   Ollama  EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER_CODE=local
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKER_DELAY_MS=5000

# Must match a rw_embedding_models.rw_model_code row loaded by the seed.
# Switching to a hosted embedding model means registering its code there first.
EMBEDDING_MODEL_CODE=deterministic-1536

# ----- RAG tuning -------------------------------------------------------------
RAG_CANDIDATE_LIMIT=12
RAG_SIMILARITY_FLOOR=0.05
RAG_MAX_CONTEXT_CHARS=6000

# ----- Seed -------------------------------------------------------------------
# Path to the corpus the seed loader reads. The compose `seed` service mounts
# database/seeds at /seed and overrides this; only set it when seeding by hand.
SEED_FILE=../database/seeds/seed.json
